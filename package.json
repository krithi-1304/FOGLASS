{
  "name": "foglass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && pnpm prepare:pages && pnpm verify:release",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project backend/tsconfig.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test --reporter=line && pnpm build",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "api:dev": "wrangler dev --config backend/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "api:migrate": "wrangler d1 migrations apply foglass-letters --local --config backend/wrangler.jsonc",
    "api:deploy": "wrangler deploy --config backend/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@mediapipe/tasks-vision": "^1.1.0",
    "lil-gui": "^0.20.0",
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/stats.js": "^0.17.4",
    "@types/webxr": "^0.5.24",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.150.0"
  }
}
