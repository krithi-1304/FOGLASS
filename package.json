{
  "name": "foglass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test --reporter=line && pnpm build",
    "prepare:pages": "node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@mediapipe/tasks-vision": "^1.1.0",
    "lil-gui": "^0.20.0",
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/stats.js": "^0.17.4",
    "@types/webxr": "^0.5.24",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
